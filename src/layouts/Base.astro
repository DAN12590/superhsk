---
import '../styles/global.css';
import { copy, routes, url, EMAIL, type Lang } from '../i18n';

interface Props { lang: Lang; title: string; description: string; page: 'home' | 'privacy' }
const { lang, title, description, page } = Astro.props;
const t = copy[lang];
const other: Lang = lang === 'en' ? 'es' : 'en';
const home = url(routes[lang].home);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="alternate" hreflang="en" href={url(routes.en[page])} />
  <link rel="alternate" hreflang="es" href={url(routes.es[page])} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700&family=Noto+Serif+SC:wght@500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="bar">
    <a class="mark" href={home}><span class="seal" aria-hidden="true">汉</span>SuperHSK</a>
    <nav>
      {page === 'home' && <a href="#app">{t.nav.app}</a>}
      {page === 'home' && <a href="#levels">{t.nav.levels}</a>}
      <a href={url(routes[lang].privacy)}>{t.nav.privacy}</a>
      <a class="lang" href={url(routes[other][page])} hreflang={other}>{t.other}</a>
    </nav>
  </header>
  <slot />
  <footer class="foot">
    <span class="mark small"><span class="seal" aria-hidden="true">汉</span>SuperHSK</span>
    <span>{t.footer.contact}: <a href={`mailto:${EMAIL}`}>{EMAIL}</a></span>
    <a href={url(routes[lang].privacy)}>{t.footer.privacy}</a>
    <a href={url(routes[other][page])} hreflang={other}>{t.other}</a>
  </footer>
</body>
</html>
