---
import '../styles/global.css';
import '../styles/pages.css';
import '../styles/motion.css';
import '../styles/app.css';
import '../styles/effects.css';
import { ClientRouter } from 'astro:transitions';
import Backdrop from '../components/Backdrop.astro';
import { common, nav, routes, url, EMAIL, type Lang, type Page } from '../i18n';

interface Props { lang: Lang; title: string; description: string; page: Page }
const { lang, title, description, page } = Astro.props;
const c = common[lang];
const other: Lang = lang === 'en' ? 'es' : 'en';
const home = url(routes[lang].home);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="alternate" hreflang="en" href={url(routes.en[page])} />
  <link rel="alternate" hreflang="es" href={url(routes.es[page])} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700&family=Noto+Serif+SC:wght@500;700&display=swap" rel="stylesheet" />
  <ClientRouter />
</head>
<body>
  <canvas class="halftone" aria-hidden="true" transition:persist="halftone"></canvas>
  <Backdrop />
  <header class="bar">
    <a class="mark" href={home}><span class="seal" aria-hidden="true">汉</span>SuperHSK</a>
    <nav>
      {nav[lang].map((item) => (
        <a href={url(routes[lang][item.page])} aria-current={item.page === page ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="lang" href={url(routes[other][page])} hreflang={other} lang={other} data-astro-reload>{c.other}</a>
    </nav>
  </header>
  <div class="page" transition:animate="fade">
    <slot />
  </div>
  <footer class="foot">
    <span class="mark small"><span class="seal" aria-hidden="true">汉</span>SuperHSK</span>
    <span>{c.contact}: <a href={`mailto:${EMAIL}`}>{EMAIL}</a></span>
    {nav[lang].map((item) => <a href={url(routes[lang][item.page])}>{item.label}</a>)}
  </footer>
  <button class="totop" type="button" aria-label={lang === 'es' ? 'Volver arriba' : 'Back to top'}>
    <svg viewBox="0 0 48 48" aria-hidden="true"><circle class="ring-bg" cx="24" cy="24" r="21" /><circle class="ring" cx="24" cy="24" r="21" pathLength="1" /><path class="arrow" d="M24 32V17M17 23l7-7 7 7" /></svg>
  </button>
  <script>import "../scripts/motion.ts";</script>
</body>
</html>
