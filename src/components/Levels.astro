---
import Base from '../layouts/Base.astro';
import { routes, url, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';

type Word = [string, string, string, string];
const levels: { name: string; state: string; later?: boolean; about: string; words: Word[] }[] = [
  {
    name: 'HSK 1', state: es ? 'Disponible' : 'Ready',
    about: es ? 'Lo básico para presentarte: saludos, números, la familia, la hora y lo que comes y bebes.' : 'The basics to introduce yourself: greetings, numbers, family, time and what you eat and drink.',
    words: [['便宜', 'piányi', 'cheap', 'barato'], ['谢谢', 'xièxie', 'thank you', 'gracias'], ['朋友', 'péngyou', 'friend', 'amigo'], ['喝', 'hē', 'to drink', 'beber'],
            ['水', 'shuǐ', 'water', 'agua'], ['今天', 'jīntiān', 'today', 'hoy'], ['猫', 'māo', 'cat', 'gato'], ['学生', 'xuésheng', 'student', 'estudiante']],
  },
  {
    name: 'HSK 2', state: es ? 'Disponible' : 'Ready',
    about: es ? 'El día a día: ir de compras, pedir comida, moverte por la ciudad, el tiempo y tus planes.' : 'Everyday life: shopping, ordering food, getting around, the weather and your plans.',
    words: [['咖啡', 'kāfēi', 'coffee', 'café'], ['旅游', 'lǚyóu', 'to travel', 'viajar'], ['运动', 'yùndòng', 'sport', 'deporte'], ['生日', 'shēngrì', 'birthday', 'cumpleaños'],
            ['准备', 'zhǔnbèi', 'to prepare', 'preparar'], ['已经', 'yǐjīng', 'already', 'ya'], ['快乐', 'kuàilè', 'happy', 'feliz'], ['送', 'sòng', 'to give', 'regalar']],
  },
  {
    name: 'HSK 3', state: es ? 'Disponible' : 'Ready',
    about: es ? 'Hablar de tu vida: costumbres, salud, lo que te interesa, lo que te preocupa y lo que has decidido.' : 'Talking about your life: habits, health, what interests or worries you and what you have decided.',
    words: [['习惯', 'xíguàn', 'habit', 'costumbre'], ['健康', 'jiànkāng', 'health', 'salud'], ['决定', 'juédìng', 'to decide', 'decidir'], ['担心', 'dānxīn', 'to worry', 'preocuparse'],
            ['环境', 'huánjìng', 'environment', 'entorno'], ['季节', 'jìjié', 'season', 'estación'], ['安静', 'ānjìng', 'quiet', 'tranquilo'], ['感兴趣', 'gǎn xìngqù', 'interested', 'interesarse']],
  },
  {
    name: 'HSK 4', state: es ? 'Disponible' : 'Ready',
    about: es ? 'Textos más largos, opiniones y matices: noticias, trabajo, dinero, viajes y defender lo que piensas.' : 'Longer texts, opinions and nuance: news, work, money, travel and arguing your point.',
    words: [['经验', 'jīngyàn', 'experience', 'experiencia'], ['解释', 'jiěshì', 'to explain', 'explicar'], ['尊重', 'zūnzhòng', 'to respect', 'respetar'], ['积极', 'jījí', 'active, positive', 'activo, positivo'],
            ['建议', 'jiànyì', 'to suggest', 'sugerir'], ['也许', 'yěxǔ', 'perhaps', 'quizás'], ['甚至', 'shènzhì', 'even', 'incluso'], ['肯定', 'kěndìng', 'definitely', 'seguro']],
  },
  {
    name: 'HSK 5', state: es ? 'En preparación' : 'In progress', later: true,
    about: es ? 'Lecturas largas, chino escrito más formal y frases hechas. Llegará en dos partes, 5A y 5B, en actualizaciones.' : 'Long readings, more formal written Chinese and set phrases. It will arrive in two parts, 5A and 5B, in updates.',
    words: [['未来', 'wèilái', 'future', 'futuro'], ['合作', 'hézuò', 'to cooperate', 'cooperar'], ['意义', 'yìyì', 'meaning', 'sentido'], ['曾经', 'céngjīng', 'once, in the past', 'alguna vez, antes']],
  },
];
const L = es
  ? { title: 'Niveles — SuperHSK', h1: 'Los niveles', lead: 'El HSK es el examen oficial de chino. El curso sigue sus niveles del HSK 3.0, la versión actual, y cada uno se apoya en el anterior. Toca una palabra para ver qué significa.', method: 'Ver cómo funciona una unidad' }
  : { title: 'Levels — SuperHSK', h1: 'The levels', lead: 'HSK is the official Chinese exam. The course follows its HSK 3.0 levels, the current version, and each one builds on the one before. Tap a word to see its meaning.', method: 'See how a unit works' };
---
<Base lang={lang} title={L.title} description={L.lead} page="levels">
  <main class="inner">
    <header class="intro">
      <h1>{L.h1}</h1>
      <p class="lead">{L.lead}</p>
    </header>
    <div class="stairs" aria-hidden="true">
      {[[1, 294], [2, 491], [3, 978], [4, 1950], [5, 3497]].map(([n, w]) => (
        <div class={`stair ${n === 5 ? 'later' : ''}`} style={`--h:${Math.sqrt(w / 3497).toFixed(3)}`}>
          <b class="stair-n">{n}</b>
          {n === 5
            ? <span class="stair-l">{es ? 'En preparación' : 'In progress'}</span>
            : <><span class="stair-w">{w}</span><span class="stair-l">{es ? 'palabras' : 'words'}</span></>}
        </div>
      ))}
    </div>
    {levels.map((lv, i) => (
      <section class={`level ${lv.later ? 'later' : ''}`}>
        <span class="lv-big" aria-hidden="true">{i + 1}</span>
        <div class="lv-head">
          <h2>{lv.name}</h2>
          <span class="state">{lv.state}</span>
          <p>{lv.about}</p>
        </div>
        <ul class="words">
          {lv.words.map(([hz, py, en, esp]) => (
            <li>
              <button type="button" class="word" aria-pressed="false">
                <span class="front"><span class="hz" lang="zh-CN">{hz}</span><span class="py">{py}</span></span>
                <span class="back">{es ? esp : en}</span>
              </button>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p class="links"><a href={url(routes[lang].method)}>{L.method}</a></p>
  </main>
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('.word').forEach((b) => {
      b.onclick = () => b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
    });
  });
</script>
