---
import Base from '../layouts/Base.astro';
import Build from './Build.astro';
import Tour from './Tour.astro';
import PlayBadge from './PlayBadge.astro';
import { common, copy, routes, url, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
const word = ['学', '中', '文'];
// Chao tone letters on a 1–5 scale, drawn left to right: 55, 35, 214, 51.
const contours = ['M10 10 L190 10', 'M10 50 L190 10', 'M10 70 C50 98 95 98 190 30', 'M10 10 L190 90'];
---
<Base lang={lang} title={t.title} description={t.description} page="home">
  <main>
    <section class="hero">
      <div class="hero-text">
        <h1>{t.hero.title}</h1>
        <p class="lead">{t.hero.lead}</p>
        <PlayBadge lang={lang} />
        <p class="status">{common[lang].status}</p>
      </div>
      <div class="hero-phone">
        <div class="phone">
          <img class="shot on" src={url(`shots/${lang}/today.webp`)} alt="" width="720" height="1600" fetchpriority="high" />
        </div>
        <div class="phone back" aria-hidden="true">
          <img class="shot on" src={url(`shots/${lang}/word.webp`)} alt="" width="720" height="1600" />
        </div>
      </div>
    </section>

    <Tour lang={lang} />

    <section class="block try">
      <div class="head">
        <h2>{t.try.title}</h2>
        <p>{t.try.lead}</p>
      </div>
      <figure class="sheet" aria-label={t.hero.caption}>
        <div class="row">
          {word.map((hz) => (
            <div class="cell big">
              <div class="writer" data-char={hz}><span class="fallback">{hz}</span></div>
            </div>
          ))}
          <div class="cell big turn"><div class="quiz" data-char="学"></div></div>
        </div>
        <figcaption>
          <span class="say" data-done={t.hero.done}>{t.hero.caption}</span>
          <span class="prompt" role="status" data-text={t.hero.yourTurn}></span>
          <button class="again" type="button" hidden>{t.hero.again}</button>
        </figcaption>
      </figure>
    </section>

    <Build lang={lang} />

    <section class="block tones">
      <div class="head">
        <h2>{t.tones.title}</h2>
        <p>{t.tones.lead}</p>
      </div>
      <div class="tonepad">
        <svg class="chart" viewBox="0 0 200 100" aria-hidden="true">
          {[10, 30, 50, 70, 90].map((y) => <line x1="0" x2="200" y1={y} y2={y} />)}
          {contours.map((d, i) => <path class={`c c${i + 1}`} d={d} />)}
          <circle class="dot" r="6" cx="-20" cy="-20" />
        </svg>
        <div class="keys">
          {t.tones.items.map((item, i) => (
            <button type="button" class="key" data-tone={i + 1} data-audio={url(`audio/ma${i + 1}.mp3`)}>
              <span class="py">{item.py}</span>
              <span class="hz">{item.hz}</span>
              <span class="mn">{item.meaning}</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="block privacy">
      <div class="head">
        <h2>{t.privacy.title}</h2>
      </div>
      <div class="notes">
        {t.privacy.items.map((line) => <p>{line}</p>)}
        <a href={url(routes[lang].privacy)}>{t.privacy.link}</a>
      </div>
    </section>

    <section class="final">
      <div class="final-text">
        <h2>{t.final.title}</h2>
        <p>{t.final.lead}</p>
        <PlayBadge lang={lang} />
        <a class="more" href={url(routes[lang].method)}>{t.app.more}</a>
      </div>
      <div class="phone final-phone">
        <img class="shot on" src={url(`shots/${lang}/write.webp`)} alt="" width="720" height="1600" loading="lazy" />
      </div>
    </section>
  </main>
</Base>

<script>
  import HanziWriter from 'hanzi-writer';
  import gsap from 'gsap';

  const data = import.meta.glob('../data/*.json', { import: 'default' });
  const load = (c: string, done: (d: never) => void) => { data[`../data/${c}.json`]().then((d) => done(d as never)); };

  function hero() {
    const sheet = document.querySelector('.sheet');
    if (!sheet) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const css = getComputedStyle(document.documentElement);
    const ink = css.getPropertyValue('--ink').trim();
    const guide = css.getPropertyValue('--guide').trim();
    const jade = css.getPropertyValue('--jade').trim();
    const seal = css.getPropertyValue('--seal').trim();

    const writers = [...sheet.querySelectorAll<HTMLElement>('.writer')].map((el) => {
      const size = el.clientWidth;
      el.innerHTML = '';
      return HanziWriter.create(el, el.dataset.char!, {
        width: size, height: size, padding: size * 0.06,
        strokeColor: ink, outlineColor: guide, showOutline: true, showCharacter: reduced,
        strokeAnimationSpeed: 1.1, delayBetweenStrokes: 90, charDataLoader: load,
      });
    });

    const quizEl = sheet.querySelector<HTMLElement>('.quiz')!;
    const prompt = sheet.querySelector<HTMLElement>('.prompt')!;
    const say = sheet.querySelector<HTMLElement>('.say')!;
    const again = sheet.querySelector<HTMLButtonElement>('.again')!;
    const size = quizEl.clientWidth;
    const quiz = HanziWriter.create(quizEl, quizEl.dataset.char!, {
      width: size, height: size, padding: size * 0.06,
      strokeColor: jade, outlineColor: guide, drawingColor: ink, highlightColor: seal,
      showOutline: true, showCharacter: false, drawingWidth: Math.max(14, size / 14),
      showHintAfterMisses: 2, highlightOnComplete: true, charDataLoader: load,
    });

    const startQuiz = () => {
      quizEl.closest('.cell')!.classList.add('active');
      prompt.textContent = prompt.dataset.text!;
      say.hidden = true;
      again.hidden = true;
      quiz.quiz({
        onComplete: () => {
          prompt.textContent = say.dataset.done!;
          again.hidden = false;
        },
      });
    };
    again.onclick = () => { quiz.hideCharacter(); startQuiz(); };

    if (reduced) { startQuiz(); return; }
    setTimeout(async () => {
      for (const w of writers) await w.animateCharacter();
      startQuiz();
    }, 900);
  }

  function tones() {
    const pad = document.querySelector('.tonepad');
    if (!pad) return;
    const chart = pad.querySelector<SVGSVGElement>('.chart')!;
    const dot = chart.querySelector<SVGCircleElement>('.dot')!;
    let audio: HTMLAudioElement | null = null;
    pad.querySelectorAll<HTMLButtonElement>('.key').forEach((key) => {
      key.onclick = () => {
        pad.querySelectorAll('.key').forEach((k) => k.classList.toggle('on', k === key));
        const path = chart.querySelector<SVGPathElement>(`.c${key.dataset.tone}`)!;
        audio?.pause();
        audio = new Audio(key.dataset.audio);
        audio.play().catch(() => {});
        // The curve is drawn while the syllable sounds; the dot rides along it.
        const len = path.getTotalLength();
        chart.querySelectorAll<SVGPathElement>('.c').forEach((p) => { gsap.killTweensOf(p); gsap.set(p, { autoAlpha: p === path ? 1 : 0 }); });
        gsap.killTweensOf(dot);
        const state = { t: 0 };
        gsap.fromTo(path, { strokeDasharray: len, strokeDashoffset: len }, { strokeDashoffset: 0, duration: 0.75, ease: 'power1.inOut' });
        gsap.fromTo(dot, { autoAlpha: 1 }, { autoAlpha: 1, duration: 0.01 });
        gsap.to(state, {
          t: 1, duration: 0.75, ease: 'power1.inOut',
          onUpdate: () => { const pt = path.getPointAtLength(state.t * len); dot.setAttribute('cx', String(pt.x)); dot.setAttribute('cy', String(pt.y)); },
        });
      };
    });
  }

  document.addEventListener('astro:page-load', () => { hero(); tones(); });
</script>
