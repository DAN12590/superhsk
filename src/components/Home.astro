---
import Base from '../layouts/Base.astro';
import { copy, routes, url, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
const word = ['学', '中', '文'];
---
<Base lang={lang} title={t.title} description={t.description} page="home">
  <main>
    <section class="hero">
      <h1>{t.hero.title}</h1>
      <p class="lead">{t.hero.lead}</p>
      <p class="status">{t.hero.status}</p>

      <figure class="sheet" aria-label={t.hero.caption}>
        <div class="row">
          {word.map((hz) => (
            <div class="cell big">
              <div class="writer" data-char={hz}><span class="fallback">{hz}</span></div>
            </div>
          ))}
          <div class="cell big ghost" aria-hidden="true"><span>学</span></div>
          <div class="cell big ghost" aria-hidden="true"><span>中</span></div>
          <div class="cell big ghost" aria-hidden="true"><span>文</span></div>
        </div>
        <figcaption>{t.hero.caption}</figcaption>
      </figure>
    </section>

    <section id="app" class="block">
      <div class="head">
        <h2>{t.app.title}</h2>
        <p>{t.app.lead}</p>
      </div>
      <ul class="drills">
        {t.app.items.map((item) => (
          <li>
            <div class="cell small" aria-hidden="true"><span>{item.hz}</span></div>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section id="levels" class="block">
      <div class="head">
        <h2>{t.levels.title}</h2>
        <p>{t.levels.lead}</p>
      </div>
      <ol class="path">
        {t.levels.items.map((level, i) => (
          <li class={i === 3 ? 'later' : ''}>
            <span class="step">{level.name}</span>
            <p>{level.text}</p>
            <span class="state">{level.state}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="block privacy">
      <div class="head">
        <h2>{t.privacy.title}</h2>
      </div>
      <div class="notes">
        {t.privacy.items.map((line) => <p>{line}</p>)}
        <a href={url(routes[lang].privacy)}>{t.privacy.link}</a>
      </div>
    </section>
  </main>
</Base>

<script>
  import HanziWriter from 'hanzi-writer';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const css = getComputedStyle(document.documentElement);
  const ink = css.getPropertyValue('--ink').trim();
  const outline = css.getPropertyValue('--guide').trim();
  const loaders = import.meta.glob('../data/*.json', { import: 'default' });

  const cells = [...document.querySelectorAll<HTMLElement>('.writer')];
  const writers = cells.map((el) => {
    const char = el.dataset.char!;
    const size = el.clientWidth;
    el.querySelector('.fallback')?.remove();
    return HanziWriter.create(el, char, {
      width: size,
      height: size,
      padding: size * 0.06,
      strokeColor: ink,
      outlineColor: outline,
      showOutline: true,
      showCharacter: reduced,
      strokeAnimationSpeed: 1.1,
      delayBetweenStrokes: 90,
      charDataLoader: (c, done) => {
        loaders[`../data/${c}.json`]().then((d) => done(d as never));
      },
    });
  });

  if (!reduced) {
    // One orchestrated moment: the word is written once, character after character.
    const run = async () => {
      for (const w of writers) await w.animateCharacter();
    };
    setTimeout(run, 400);
  }
</script>
