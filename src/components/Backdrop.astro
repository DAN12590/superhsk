---
/**
 * A quiet layer behind every page: very large, very faint characters that drift at different
 * speeds as you scroll (GSAP parallax, see motion.ts), over a faint practice-paper grid.
 */
interface Props { set?: string }
const { set = '学写读说音字书文' } = Astro.props;
const glyphs = [...set];
// Positions down the page, alternating sides, with a speed for the parallax.
const spots = [
  { top: 2, left: 62, size: 34, speed: -0.25 },
  { top: 16, left: -8, size: 28, speed: 0.18 },
  { top: 30, left: 70, size: 26, speed: -0.4 },
  { top: 44, left: 4, size: 26, speed: 0.3 },
  { top: 58, left: 64, size: 30, speed: -0.2 },
  { top: 70, left: -6, size: 26, speed: 0.35 },
  { top: 82, left: 58, size: 32, speed: -0.3 },
  { top: 93, left: 10, size: 26, speed: 0.2 },
];
---
<div class="backdrop" aria-hidden="true">
  {spots.map((s, i) => (
    <span class="bg-glyph" data-speed={s.speed} style={`top:${s.top}%;left:${s.left}%;font-size:${s.size}vw`}>{glyphs[i % glyphs.length]}</span>
  ))}
</div>
