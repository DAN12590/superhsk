---
import Base from '../layouts/Base.astro';
import { EMAIL, routes, url, type Lang } from '../i18n';
import Owner from './Owner.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const mail = `<a href="mailto:${EMAIL}">${EMAIL}</a>`;
const aepd = '<a href="https://www.aepd.es/">www.aepd.es</a>';
const githubPrivacy = 'https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement';

const P = {
  en: {
    title: 'Privacy policy — SuperHSK',
    h1: 'Privacy policy',
    updated: 'Last updated on 22 November 2026.',
    summary: 'SuperHSK has no accounts and no analytics. Your progress is stored only on your phone. Data leaves your phone only when you use a feature that needs it — AI exercises, speech recognition, a video you choose to watch, or sending us a message — and only what that feature needs.',
    controllerTitle: 'Who we are',
    controller: ['SuperHSK is an app for learning Chinese. The data controller is ', '. Their full details are in the ', 'legal notice', '.'],
    contact: 'For any question about this policy, write to',
    localTitle: 'Data stored on your phone',
    localData: 'Your course progress, reviews, settings and statistics are stored only on your device. We cannot see them. If you export a backup, the file is saved where you choose and is not sent to us; if you send it with another app (email, a chat, a cloud drive), it goes only where you send it. If you turn on “Save to my Google account”, a copy of your progress is kept in a hidden folder of your own Google Drive that only this app can open; it goes from your phone to Google directly, we never receive it, and you can stop and delete that copy in Settings. Uninstalling the app or clearing its data deletes everything on the device.',
    outTitle: 'Data that leaves your phone',
    cols: ['Feature', 'What is sent', 'Who receives it'],
    rows: [
      ['AI exercises', 'The text of the exercise and your answer. No name, account or contacts.', 'Groq, the AI service that answers, always through our server. Our server also receives a random ID of the app installation (not linked to you) and your IP address, only to count each phone’s questions for the day.'],
      ['Speaking exercises', 'Your voice while the microphone is on, to turn it into text.', 'Your phone’s speech recognition service, usually Google. The app keeps no recordings.'],
      ['Messages and problem reports', 'What you write, the exercise you were on, the app version, the phone model and the app language.', 'Our feedback server, which forwards it to the developer.'],
      ['Optional video ads', 'Only if you choose to watch a video to get more AI uses: the ad network receives what it needs to show the ad, such as your device’s advertising ID, IP address and device model.', 'Google AdMob, under the Google privacy policy. You can reset or delete your advertising ID in Android settings.'],
      ['Crash reports', 'The technical error, the app version, the phone model and the app language. No personal content.', 'Our feedback server, so the bug can be fixed.'],
    ],
    nosell: 'We do not sell your data, and we do not use it to identify you. Ads are only shown when you ask for a video.',
    basesTitle: 'Why we process your data',
    bases: [
      'For AI exercises and speech recognition, we process data to provide the service you request (GDPR Article 6(1)(b)).',
      'We process messages and problem reports with your consent when you send them (Article 6(1)(a)).',
      `We have a legitimate interest in fixing bugs using crash reports (Article 6(1)(f)). You can object to that processing by writing to ${mail}.`,
      'For optional video ads, we rely on your consent (Article 6(1)(a)). In the European Economic Area (EEA) and the UK, we ask for consent through Google’s consent form before showing personalised ads.',
    ],
    rest: [
      ['Service providers and international transfers', 'We use Groq (Groq, Inc., United States, and its affiliates such as Groq UK Limited) for AI exercises, Google LLC (United States) for speech recognition, AdMob and, if you turn it on, saving your progress in your Google Drive, and Cloudflare, Inc. for our feedback server. The developer receives feedback via Telegram. Transfers to the United States rely on the EU–U.S. Data Privacy Framework where the recipient participates, or on standard contractual clauses.'],
      ['How long we keep data', 'We do not store the text from AI exercises. The daily count of AI questions per installation and IP address is deleted the next day. We keep messages and problem reports for up to 12 months and then delete them. We also keep crash reports for up to 12 months. Groq, Google and Cloudflare follow their own policies for the data they retain.'],
      ['Your rights', `You can request access to your data, correction, deletion, restriction of processing or data portability, or object to processing, by writing to ${mail}. You can also withdraw your consent at any time. You have the right to file a complaint with the Spanish Data Protection Agency (${aepd}) or with the data protection authority in your country.`],
      ['Permissions', '<b>Microphone</b>, only for speaking exercises and only when you start one. <b>Notifications</b>, for the daily reminder if you turn it on. <b>Internet</b>, for AI exercises, speech recognition and messages; the rest of the app works offline.'],
      ['Children', 'SuperHSK is not directed at children under 14 and does not knowingly collect their data. Outside Spain, a higher minimum age in your country applies.'],
      ['Deleting your data', `SuperHSK has no accounts, so there is no account to delete. To delete your data: <b>1. On your phone</b> (progress, reviews, settings, statistics): uninstall SuperHSK or clear its data in Android settings; it is deleted at once. <b>2. Copy in your Google Drive</b> (if you turned on “Save to my Google account”): in SuperHSK, open Settings and delete the cloud copy, or remove SuperHSK’s access in your Google account settings (Security → Third-party connections); the hidden copy is deleted. <b>3. Messages, problem reports and crash reports</b>: write to ${mail} from the app’s Settings or by email, saying roughly when you sent them; we delete them within 30 days. If you do not ask, we delete them anyway after 12 months. <b>Kept data</b>: we keep nothing else. The daily count of AI questions is deleted the next day, and we never store the text of AI exercises. Your purchase history is kept by Google Play, and ad data by Google AdMob, under Google’s privacy policy.`],
      ['This website', `GitHub Pages (GitHub, Inc.) hosts this website. GitHub logs visitors’ IP addresses for security under its <a href="${githubPrivacy}">privacy statement</a>. The site uses no cookies or analytics and loads no third-party resources. The fonts are served from this website.`],
      ['Changes', 'If this policy changes, this page and its date will be updated.'],
    ],
  },
  es: {
    title: 'Política de privacidad — SuperHSK',
    h1: 'Política de privacidad',
    updated: 'Actualizada el 22 de noviembre de 2026.',
    summary: 'SuperHSK no tiene cuentas ni analítica. Tu progreso se guarda solo en tu móvil. Los datos solo salen del móvil cuando usas una función que los necesita —ejercicios con IA, reconocimiento de voz, un vídeo que eliges ver o enviarnos un mensaje— y solo lo que esa función necesita.',
    controllerTitle: 'Quiénes somos',
    controller: ['SuperHSK es una app para aprender chino. El responsable del tratamiento es ', '. Sus datos completos están en el ', 'aviso legal', '.'],
    contact: 'Para cualquier duda sobre esta política, escribe a',
    localTitle: 'Datos guardados en tu móvil',
    localData: 'Tu progreso del curso, los repasos, los ajustes y las estadísticas se guardan solo en tu dispositivo. Nosotros no podemos verlos. Si exportas una copia de seguridad, el archivo se guarda donde elijas y no nos llega; si la envías con otra app (correo, un chat, una nube), solo va adonde la envíes. Si activas «Guardar en mi cuenta de Google», se guarda una copia de tu progreso en una carpeta oculta de tu propio Google Drive que solo puede abrir esta app; va de tu móvil a Google directamente, nosotros nunca la recibimos, y puedes dejar de guardar y borrar esa copia en Ajustes. Desinstalar la app o borrar sus datos elimina todo lo que hay en el dispositivo.',
    outTitle: 'Datos que salen de tu móvil',
    cols: ['Función', 'Qué se envía', 'Quién lo recibe'],
    rows: [
      ['Ejercicios con IA', 'El texto del ejercicio y tu respuesta. Ni nombre, ni cuenta, ni contactos.', 'Groq, el servicio de IA que responde, siempre a través de nuestro servidor. Nuestro servidor recibe también un identificador aleatorio de la instalación de la app (no ligado a ti) y tu dirección IP, solo para contar las preguntas del día de cada móvil.'],
      ['Ejercicios de hablar', 'Tu voz mientras el micrófono está activo, para pasarla a texto.', 'El reconocimiento de voz de tu móvil, normalmente el de Google. La app no guarda grabaciones.'],
      ['Mensajes y avisos de fallos', 'Lo que escribes, el ejercicio en el que estabas, la versión de la app, el modelo del móvil y el idioma de la app.', 'Nuestro servidor de mensajes, que se lo pasa al desarrollador.'],
      ['Vídeos de anuncios opcionales', 'Solo si eliges ver un vídeo para tener más usos de la IA: la red de anuncios recibe lo que necesita para mostrarlo, como el identificador de publicidad del móvil, la dirección IP y el modelo del móvil.', 'Google AdMob, según la política de privacidad de Google. Puedes restablecer o borrar tu identificador de publicidad en los ajustes de Android.'],
      ['Informes de cierres', 'El error técnico, la versión de la app, el modelo del móvil y el idioma de la app. Nada de contenido personal.', 'Nuestro servidor de mensajes, para poder arreglar el fallo.'],
    ],
    nosell: 'No vendemos tus datos y no los usamos para identificarte. Solo se muestran anuncios cuando pides un vídeo.',
    basesTitle: 'Por qué tratamos tus datos',
    bases: [
      'Tratamos los datos de los ejercicios con IA y del reconocimiento de voz para prestarte el servicio que pides (art. 6.1.b del RGPD).',
      'Tratamos los mensajes y avisos de fallos con tu consentimiento al enviarlos (art. 6.1.a).',
      `Para los informes de cierres, tenemos un interés legítimo en arreglar fallos (art. 6.1.f). Puedes oponerte a ese tratamiento escribiendo a ${mail}.`,
      'Para los vídeos de anuncios opcionales, la base es tu consentimiento (art. 6.1.a). En el Espacio Económico Europeo (EEE) y el Reino Unido, te lo pedimos mediante el formulario de consentimiento de Google antes de mostrarte anuncios personalizados.',
    ],
    rest: [
      ['Proveedores y transferencias internacionales', 'Usamos Groq (Groq, Inc., EE. UU., y sus filiales, como Groq UK Limited) para los ejercicios con IA, Google LLC (EE. UU.) para el reconocimiento de voz, AdMob y, si lo activas, guardar tu progreso en tu Google Drive, y Cloudflare, Inc. para el servidor de mensajes. El desarrollador recibe los mensajes por Telegram. Las transferencias a EE. UU. se amparan en el Marco de Privacidad de Datos UE-EE. UU. cuando el destinatario está adherido, o en cláusulas contractuales tipo.'],
      ['Cuánto tiempo guardamos los datos', 'No guardamos el texto de los ejercicios con IA. La cuenta diaria de preguntas a la IA por instalación y dirección IP se borra al día siguiente. Conservamos los mensajes y avisos de fallos como máximo 12 meses y después los borramos. También conservamos los informes de cierres como máximo 12 meses. Los datos que guarden Groq, Google y Cloudflare se rigen por sus propias políticas.'],
      ['Tus derechos', `Puedes ejercer tus derechos de acceso, rectificación, supresión, oposición, limitación del tratamiento y portabilidad escribiendo a ${mail}. También puedes retirar tu consentimiento en cualquier momento. Tienes derecho a reclamar ante la Agencia Española de Protección de Datos (${aepd}) o ante la autoridad de protección de datos de tu país.`],
      ['Permisos', '<b>Micrófono</b>, solo para los ejercicios de hablar y solo cuando empiezas uno. <b>Notificaciones</b>, para el recordatorio diario si lo activas. <b>Internet</b>, para la IA, el reconocimiento de voz y los mensajes; el resto de la app funciona sin conexión.'],
      ['Menores', 'SuperHSK no está dirigida a menores de 14 años y no recoge sus datos a sabiendas. Fuera de España, se aplica la edad mínima de tu país si es mayor.'],
      ['Borrar tus datos', `SuperHSK no tiene cuentas, así que no hay ninguna cuenta que borrar. Para borrar tus datos: <b>1. En tu móvil</b> (progreso, repasos, ajustes, estadísticas): desinstala SuperHSK o borra sus datos en los ajustes de Android; se eliminan al momento. <b>2. Copia en tu Google Drive</b> (si activaste «Guardar en mi cuenta de Google»): en SuperHSK, abre Ajustes y borra la copia de la nube, o quita el acceso de SuperHSK en los ajustes de tu cuenta de Google (Seguridad → Conexiones con terceros); la copia oculta se elimina. <b>3. Mensajes, avisos de fallos e informes de cierres</b>: escribe a ${mail} indicando más o menos cuándo los enviaste; los borramos en un plazo de 30 días. Si no lo pides, se borran igualmente a los 12 meses. <b>Datos que se conservan</b>: ninguno más. La cuenta diaria de preguntas a la IA se borra al día siguiente y nunca guardamos el texto de los ejercicios con IA. El historial de compras lo guarda Google Play, y los datos de anuncios Google AdMob, según la política de privacidad de Google.`],
      ['Esta web', `GitHub Pages (GitHub, Inc.) aloja esta web. GitHub registra la dirección IP de las visitas por seguridad, según su <a href="${githubPrivacy}">política de privacidad</a>. La web no usa cookies ni analítica ni carga recursos de terceros. Las fuentes se sirven desde la propia web.`],
      ['Cambios', 'Si esta política cambia, se actualizarán esta página y su fecha.'],
    ],
  },
}[lang];
---
<Base lang={lang} title={P.title} description={P.summary} page="privacy" noindex>
  <main class="doc">
    <h1>{P.h1}</h1>
    <p class="updated">{P.updated}</p>
    <p class="summary">{P.summary}</p>
    <h2>{P.controllerTitle}</h2>
    <p>{P.controller[0]}<Owner field="name" />{P.controller[1]}<a href={url(routes[lang].legal)}>{P.controller[2]}</a>{P.controller[3]} {P.contact} <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.</p>
    <h2>{P.localTitle}</h2>
    <p>{P.localData}</p>
    <h2>{P.outTitle}</h2>
    <table>
      <thead><tr>{P.cols.map((c) => <th scope="col">{c}</th>)}</tr></thead>
      <tbody>
        {P.rows.map(([a, b, c]) => (
          <tr><th scope="row">{a}</th><td data-label={P.cols[1]}>{b}</td><td data-label={P.cols[2]}>{c}</td></tr>
        ))}
      </tbody>
    </table>
    <p>{P.nosell}</p>
    <h2>{P.basesTitle}</h2>
    <ul>
      {P.bases.map((body) => <li set:html={body} />)}
    </ul>
    {P.rest.map(([h, body]) => (<><h2>{h}</h2><p set:html={body} /></>))}
  </main>
</Base>
